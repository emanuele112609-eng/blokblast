<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mio Block Blast Clone</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #121214;
            color: white;
            text-align: center;
            margin: 0;
            padding: 10px;
            user-select: none;
            -webkit-user-select: none;
        }
        h1 {
            margin-bottom: 5px;
            color: #ffcc00;
        }
        #game-container {
            display: inline-block;
            background: #1c1c1e;
            padding: 15px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.7);
            margin-top: 10px;
            touch-action: none; /* Impedisce lo scroll della pagina su mobile mentre si trascina */
        }
        #score {
            font-size: 26px;
            font-weight: bold;
            margin-bottom: 15px;
        }
        canvas {
            background: #2c2c2e;
            border-radius: 12px;
            cursor: grab;
        }
        canvas:active {
            cursor: grabbing;
        }
        #game-over {
            display: none;
            color: #ff453a;
            font-size: 32px;
            font-weight: bold;
            margin-top: 15px;
            animation: pulse 1s infinite alternate;
        }
        button {
            background: #ffcc00;
            color: #121214;
            border: none;
            padding: 12px 25px;
            font-size: 18px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            margin-top: 15px;
            transition: transform 0.1s;
        }
        button:hover {
            background: #ffe066;
            transform: scale(1.05);
        }
        @keyframes pulse {
            from { transform: scale(1); }
            to { transform: scale(1.05); }
        }
    </style>
</head>
<body>

    <h1>BLOCK BLAST</h1>
    <div id="game-container">
        <div id="score">Punteggio: <span id="score-val">0</span></div>
        <canvas id="gameCanvas" width="400" height="600"></canvas>
        <div id="game-over">GAME OVER!</div>
        <button id="restart-btn" onclick="resetGame()">Gioca Ancora</button>
    </div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

// Configurazione Griglia (8x8)
const GRID_SIZE = 8;
const CELL_SIZE = 50; // 50px * 8 = 400px di larghezza griglia

// Elenco delle forme disponibili (i blocchi tipici di Block Blast)
const SHAPES = [
    { blocks: [[1]], color: '#ff453a' },                  // 1x1
    { blocks: [[1,1],[1,1]], color: '#30d158' },            // 2x2
    { blocks: [[1,1,1]], color: '#0a84ff' },              // 1x3 Orizzontale
    { blocks: [[1],[1],[1]], color: '#bf5af2' },              // 3x1 Verticale
    { blocks: [[1,1,1],[1,1,1],[1,1,1]], color: '#ff9f0a' },  // 3x3 (Il distruttore di partite!)
    { blocks: [[1,0],[1,0],[1,1]], color: '#ff375f' },        // a L
    { blocks: [[1,1,1],[0,1,0]], color: '#5ac8fa' }         // a T
];

// Stato del gioco
let grid = Array(GRID_SIZE).fill().map(() => Array(GRID_SIZE).fill(null));
let slots = [null, null, null]; // I 3 blocchi in basso
let score = 0;
let gameOver = false;
let draggedPiece = null;

// Offset per sollevare il blocco sopra il dito/mouse così da vederlo mentre lo si trascina
const DRAG_Y_OFFSET = 80; 

function init() {
    grid = Array(GRID_SIZE).fill().map(() => Array(GRID_SIZE).fill(null));
    score = 0;
    gameOver = false;
    draggedPiece = null;
    document.getElementById('score-val').innerText = score;
    document.getElementById('game-over').style.style = 'none';
    document.getElementById('game-over').style.display = 'none';
    spawnPieces();
    draw();
}

function spawnPieces() {
    for (let i = 0; i < 3; i++) {
        const randIndex = Math.floor(Math.random() * SHAPES.length);
        slots[i] = JSON.parse(JSON.stringify(SHAPES[randIndex])); // Copia profonda del blocco
    }
}

// Funzione di disegno principale
function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // 1. Disegna la Griglia di Gioco (8x8)
    for (let r = 0; r < GRID_SIZE; r++) {
        for (let c = 0; c < GRID_SIZE; c++) {
            if (grid[r][c]) {
                ctx.fillStyle = grid[r][c];
            } else {
                ctx.fillStyle = '#3a3a3c'; // Colore celle vuote
            }
            ctx.fillRect(c * CELL_SIZE + 2, r * CELL_SIZE + 2, CELL_SIZE - 4, CELL_SIZE - 4);
        }
    }

    // Separatore tra griglia e area blocchi in basso
    ctx.fillStyle = '#48484a';
    ctx.fillRect(0, 410, canvas.width, 4);

    // 2. Disegna i 3 slot in basso con i blocchi in miniatura (scala 0.5)
    for (let i = 0; i < 3; i++) {
        let piece = slots[i];
        if (!piece) continue;

        let miniCell = 22; // Dimensione ridotta per l'anteprima
        let pWidth = piece.blocks[0].length * miniCell;
        let pHeight = piece.blocks.length * miniCell;
        let slotCenterX = i * (canvas.width / 3) + (canvas.width / 6);
        let slotCenterY = 510;
        let startX = slotCenterX - pWidth / 2;
        let startY = slotCenterY - pHeight / 2;

        ctx.fillStyle = piece.color;
        for (let r = 0; r < piece.blocks.length; r++) {
            for (let c = 0; c < piece.blocks[r].length; c++) {
                if (piece.blocks[r][c] === 1) {
                    ctx.fillRect(startX + c * miniCell + 1, startY + r * miniCell + 1, miniCell - 2, miniCell - 2);
                }
            }
        }
    }

    // 3. Disegna il blocco attualmente trascinato (a dimensione intera)
    if (draggedPiece) {
        let piece = draggedPiece.shape;
        let pWidth = piece.blocks[0].length * CELL_SIZE;
        let pHeight = piece.blocks.length * CELL_SIZE;
        
        // Centrato sopra il cursore/dito usando l'offset
        let startX = draggedPiece.x - pWidth / 2;
        let startY = (draggedPiece.y - DRAG_Y_OFFSET) - pHeight / 2;

        ctx.fillStyle = piece.color;
        ctx.globalAlpha = 0.85; // Leggermente trasparente durante il movimento
        for (let r = 0; r < piece.blocks.length; r++) {
            for (let c = 0; c < piece.blocks[r].length; c++) {
                if (piece.blocks[r][c] === 1) {
                    ctx.fillRect(startX + c * CELL_SIZE + 2, startY + r * CELL_SIZE + 2, CELL_SIZE - 4, CELL_SIZE - 4);
                }
            }
        }
        ctx.globalAlpha = 1.0;
    }
}

// Controlla se un blocco può essere posizionato in quelle coordinate della griglia
function canPlace(blocks, startR, startC) {
    for (let r = 0; r < blocks.length; r++) {
        for (let c = 0; c < blocks[r].length; c++) {
            if (blocks[r][c] === 1) {
                let targetR = startR + r;
                let targetC = startC + c;
                if (targetR < 0 || targetR >= GRID_SIZE || targetC < 0 || targetC >= GRID_SIZE) return false;
                if (grid[targetR][targetC] !== null) return false;
            }
        }
    }
    return true;
}

// Controlla e distrugge righe o colonne piene
function clearLines() {
    let rowsToClear = [];
    let colsToClear = [];

    // Controllo righe
    for (let r = 0; r < GRID_SIZE; r++) {
        if (grid[r].every(cell => cell !== null)) rowsToClear.push(r);
    }

    // Controllo colonne
    for (let c = 0; c < GRID_SIZE; c++) {
        let full = true;
        for (let r = 0; r < GRID_SIZE; r++) {
            if (grid[r][c] === null) { full = false; break; }
        }
        if (full) colsToClear.push(c);
    }

    // Eliminazione blocchi
    rowsToClear.forEach(r => {
        for (let c = 0; c < GRID_SIZE; c++) grid[r][c] = null;
    });
    colsToClear.forEach(c => {
        for (let r = 0; r < GRID_SIZE; r++) grid[r][c] = null;
    });

    // Calcolo Punteggio (Bonus Combo se distruggi più linee insieme)
    let cleared = rowsToClear.length + colsToClear.length;
    if (cleared > 0) {
        score += (cleared * 100) + (cleared - 1) * 50;
        document.getElementById('score-val').innerText = score;
    }
}

// Verifica se il giocatore è bloccato (Game Over)
function checkGameOver() {
    let activePieces = slots.filter(p => p !== null);
    if (activePieces.length === 0) return false;

    for (let piece of activePieces) {
        for (let r = 0; r <= GRID_SIZE - piece.blocks.length; r++) {
            for (let c = 0; c <= GRID_SIZE - piece.blocks[0].length; c++) {
                if (canPlace(piece.blocks, r, c)) {
                    return false; // C'è ancora almeno una mossa disponibile!
                }
            }
        }
    }
    return true;
}

// Gestione Coordinate Mouse/Touch relative al Canvas
function getCanvasPos(e) {
    let rect = canvas.getBoundingClientRect();
    return {
        x: (e.clientX - rect.left) * (canvas.width / rect.width),
        y: (e.clientY - rect.top) * (canvas.height / rect.height)
    };
}

// GESTIONE INPUT (Pointer Events unifica Mouse e Touch)
canvas.addEventListener('pointerdown', (e) => {
    if (gameOver) return;
    let pos = getCanvasPos(e);

    // Se clicchi nell'area degli slot in basso
    if (pos.y > 420) {
        let slotIdx = Math.floor(pos.x / (canvas.width / 3));
        if (slotIdx >= 0 && slotIdx < 3 && slots[slotIdx]) {
            draggedPiece = {
                shape: slots[slotIdx],
                originSlot: slotIdx,
                x: pos.x,
                y: pos.y
            };
            canvas.setPointerCapture(e.pointerId);
        }
    }
});

canvas.addEventListener('pointermove', (e) => {
    if (!draggedPiece) return;
    let pos = getCanvasPos(e);
    draggedPiece.x = pos.x;
    draggedPiece.y = pos.y;
    draw();
});

canvas.addEventListener('pointerup', (e) => {
    if (!draggedPiece) return;
    canvas.releasePointerCapture(e.pointerId);

    let piece = draggedPiece.shape;
    let pWidth = piece.blocks[0].length * CELL_SIZE;
    let pHeight = piece.blocks.length * CELL_SIZE;

    // Calcoliamo dove si trova l'angolo in alto a sinistra del blocco trascinato rispetto alla griglia
    let startX = draggedPiece.x - pWidth / 2;
    let startY = (draggedPiece.y - DRAG_Y_OFFSET) - pHeight / 2;

    let targetC = Math.round(startX / CELL_SIZE);
    let targetR = Math.round(startY / CELL_SIZE);

    // Se la posizione è valida, incastra il blocco
    if (canPlace(piece.blocks, targetR, targetC)) {
        for (let r = 0; r < piece.blocks.length; r++) {
            for (let c = 0; c < piece.blocks[r].length; c++) {
                if (piece.blocks[r][c] === 1) {
                    grid[targetR + r][targetC + c] = piece.color;
                }
            }
        }
        
        // Punti per aver piazzato il blocco
        score += (piece.blocks.flat().filter(b => b === 1).length) * 10;
        document.getElementById('score-val').innerText = score;

        // Svuota lo slot usato
        slots[draggedPiece.originSlot] = null;
        
        // Controlla linee completate
        clearLines();

        // Se tutti e 3 i blocchi sono stati usati, generane altri 3
        if (slots.every(s => s === null)) {
            spawnPieces();
        }

        // Verifica Game Over
        if (checkGameOver()) {
            gameOver = true;
            document.getElementById('game-over').style.display = 'block';
        }
    }

    draggedPiece = null;
